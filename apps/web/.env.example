# Endereço interno da API usado apenas pela camada server/ do Next.js.
# Desenvolvimento local: http://127.0.0.1:3001/api
# Docker Swarm: http://flowcare_api:3000/api
API_INTERNAL_URL=http://127.0.0.1:3001/api
# Confie no X-Forwarded-For somente atrás do proxy reverso configurado.
TRUST_PROXY=false
