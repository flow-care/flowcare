// Flowcare — schema Prisma (issue #199, escopo inicial: identidade + organizações)
//
// Convenções (docs/API_CONTRACT.md §1):
// - IDs: strings opacas (UUID v4 gerado no banco);
// - Datas: Timestamp(3) UTC;
// - Isolamento: toda tabela de domínio clínico carrega organizationId.
//
// Escopo DESTE PR (base de auth + onboarding):
//   User, Session, VerificationToken, PasswordResetToken,
//   Organization, Membership, Role.
// Modelos clínicos (Patient, Appointment, ...) entram nas issues seguintes.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  ADMIN
  ADMIN_PROFESSIONAL
  PROFESSIONAL
  RECEPTIONIST
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  INVITED
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum AppointmentStatus {
  RESERVED
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum ConfirmationDecisionStatus {
  PENDING
  CONFIRMED
  DECLINED
}

enum ConfirmationDecisionOrigin {
  PHONE_CALL
  WHATSAPP_MANUAL
  IN_PERSON
  OTHER
}

enum ReceptionQueueStatus {
  WAITING
  ARRIVED
  CALLED
  IN_SERVICE
  COMPLETED
  NO_SHOW
}

model OrganizationInvite {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  email          String
  role           MembershipRole
  tokenHash      String         @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
  @@index([email, expiresAt])
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  fullName      String
  phone         String?
  professionalRole String?
  professionalTitle String?
  registrationNumber String?
  profileCompletedAt DateTime?
  profilePhotoKey String? @unique
  profilePhotoContentType String?
  profilePhotoSizeBytes Int?
  passwordHash  String
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions           Session[]
  tokens             VerificationToken[]
  memberships        Membership[]
  onboarding         OnboardingProgress?
  ownedOrganizations Organization[]      @relation("OrganizationOwner")
  activeOrganizationId String? @db.Uuid
  activeOrganization Organization? @relation("ActiveOrganization", fields: [activeOrganizationId], references: [id], onDelete: SetNull)
  professionalAppointments Appointment[]
  professionalSchedulePauses ProfessionalSchedulePause[]
  decidedConfirmations AppointmentConfirmation[] @relation("ConfirmationDecidedBy")
  confirmationDecisions ConfirmationDecision[]   @relation("ConfirmationDecisionAuthor")

  @@index([email])
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  lastActiveAt DateTime  @default(now())
  userAgent    String?
  ipAddress    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Registro permanente dos comandos de revogação da própria conta.
// IDs são mantidos como valores históricos, sem FK para sessões que possam ser removidas.
model SessionRevocationAudit {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  actorSessionId String   @db.Uuid
  targetSessionId String?  @db.Uuid
  action         String
  revokedCount   Int
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
}

// Tokens de uso único (verificação de e-mail, reset de senha).
// O token em si NUNCA é armazenado: guardamos apenas o SHA-256.
model VerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  type      TokenType
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  ownerId   String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  legalName String?
  taxId String?
  contactEmail String?
  contactPhone String?
  postalCode String?
  state String?
  city String?
  district String?
  street String?
  streetNumber String?
  addressComplement String?
  logoObjectKey String? @unique
  logoContentType String?
  logoSizeBytes Int?
  logoUpdatedAt DateTime?
  detailsVersion Int @default(0)
  detailsCompletedAt DateTime?
  timezone String @default("America/Sao_Paulo")

  owner        User          @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  memberships  Membership[]
  subscription Subscription?
  invites       OrganizationInvite[]
  storageObjects StorageObject[]
  weeklyScheduleRules WeeklyScheduleRule[]
  auditLogs    AuditLog[]
  documentTemplates DocumentTemplate[]
  appointments Appointment[]
  appointmentConfirmations AppointmentConfirmation[]
  confirmationDecisions ConfirmationDecision[]
  appointmentCreationRequests AppointmentCreationRequest[]
  professionalSchedulePauses ProfessionalSchedulePause[]
  patients Patient[]
  patientCreationRequests PatientCreationRequest[]
  whatsappSession WhatsAppSession?
  activeUsers User[] @relation("ActiveOrganization")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  actorUserId    String   @db.Uuid
  action         String
  targetType     String
  targetId       String
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, action])
}

model Appointment {
  id               String               @id @default(uuid()) @db.Uuid
  organizationId   String               @db.Uuid
  patientId        String               @db.Uuid
  professionalId   String               @db.Uuid
  scheduledAt      DateTime
  durationMinutes  Int
  status           AppointmentStatus    @default(RESERVED)
  queueStatus      ReceptionQueueStatus @default(WAITING)
  arrivedAt        DateTime?
  queueUpdatedAt   DateTime?
  queueUpdatedById String?              @db.Uuid
  version          Int                  @default(0)
  notes            String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  organization          Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient               Patient                      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  professional          User                         @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  confirmation          AppointmentConfirmation?
  confirmationDecisions ConfirmationDecision[]
  creationRequests      AppointmentCreationRequest[]

  @@index([organizationId, scheduledAt, id])
  @@index([organizationId, professionalId, scheduledAt])
  @@index([organizationId, status, scheduledAt])
  @@index([organizationId, queueStatus, scheduledAt])
}

model AppointmentCreationRequest {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  idempotencyKey String
  requestHash    String
  appointmentId  String   @db.Uuid
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointment  Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@unique([organizationId, idempotencyKey])
  @@index([appointmentId])
}

model AppointmentConfirmation {
  id                String                      @id @default(uuid()) @db.Uuid
  organizationId    String                      @db.Uuid
  appointmentId     String                      @unique @db.Uuid
  status            ConfirmationDecisionStatus  @default(PENDING)
  origin            ConfirmationDecisionOrigin?
  originalMessage   String?
  originalMessageId String?
  originalMessageAt DateTime?
  note              String?
  decidedById       String?                     @db.Uuid
  decidedAt         DateTime?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointment  Appointment            @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  decidedBy    User?                  @relation("ConfirmationDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decisions    ConfirmationDecision[]

  @@index([organizationId, status, createdAt])
  @@index([organizationId, appointmentId])
}

model ConfirmationDecision {
  id             String                     @id @default(uuid()) @db.Uuid
  organizationId String                     @db.Uuid
  appointmentId  String                     @db.Uuid
  confirmationId String                     @db.Uuid
  decision       ConfirmationDecisionStatus
  origin         ConfirmationDecisionOrigin
  note           String?
  decidedById    String                     @db.Uuid
  decidedAt      DateTime                   @default(now())
  idempotencyKey String?
  requestHash    String?
  createdAt      DateTime                   @default(now())

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointment  Appointment             @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  confirmation AppointmentConfirmation @relation(fields: [confirmationId], references: [id], onDelete: Cascade)
  decidedBy    User                    @relation("ConfirmationDecisionAuthor", fields: [decidedById], references: [id], onDelete: Restrict)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, appointmentId, decidedAt])
  @@index([confirmationId, decidedAt])
}

model ProfessionalSchedulePause {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  professionalId String   @db.Uuid
  startsAt       DateTime
  endsAt         DateTime
  reason         String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  professional User @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([organizationId, professionalId, startsAt, endsAt])
}

model Patient {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  fullName        String
  normalizedName  String   @default("")
  cpf             String
  birthDate       DateTime @db.Date
  phone           String
  email           String?
  healthInsurance String?
  insuranceNumber String?
  allergies       String[] @default([])
  comorbidities   String[] @default([])
  clinicalAlerts  String[] @default([])
  medicalNotes    String?
  version         Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization     Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creationRequests PatientCreationRequest[]
  appointments     Appointment[]

  @@index([organizationId, cpf])
  @@index([organizationId, fullName])
  @@index([organizationId, normalizedName])
  @@index([organizationId, phone])
  @@index([organizationId, createdAt, id])
}

model PatientCreationRequest {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  idempotencyKey String
  requestHash    String
  patientId      String   @db.Uuid
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([organizationId, idempotencyKey])
  @@index([patientId])
}

// Private binding between a clinic and its provider session. The provider
// credential and short-lived QR payloads are never stored in the database.
model WhatsAppSession {
  id                  String   @id @default(uuid()) @db.Uuid
  organizationId      String   @unique @db.Uuid
  providerSessionName String   @unique
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model WeeklyScheduleRule {
  id                  String       @id @default(uuid()) @db.Uuid
  organizationId      String       @db.Uuid
  dayOfWeek           String
  startTime           String
  endTime             String
  slotDurationMinutes Int
  createdAt           DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, dayOfWeek])
}

model StorageObject {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  objectKey      String   @unique
  contentType    String
  sizeBytes      Int
  category       String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, category])
}

model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  organizationId String           @db.Uuid
  role           MembershipRole
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

// Progresso do onboarding guiado (issue #215) — sobrevive a recarregar a página.
model OnboardingProgress {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @db.Uuid
  currentStep String   @default("ORGANIZATION_SETUP")
  completed   Boolean  @default(false)
  draftData   Json     @default("{}")
  version     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Assinatura da clínica (decisão de produto): cada clínica criada exige
// assinatura de R$ 89/mês paga pelo dono; convidados não pagam.
// Cobrança/gateway é task futura — aqui registramos preço e estado.
enum SubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  PAST_DUE
  CANCELED
}

model Subscription {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @unique @db.Uuid
  status         SubscriptionStatus @default(PENDING_PAYMENT)
  priceCents     Int                @default(8900)
  currency       String             @default("BRL")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status])
}

enum DocumentType {
  PRESCRIPTION
  CERTIFICATE
  REPORT
  EXAM_REQUEST
}

enum TemplateStatus {
  ACTIVE
  ARCHIVED
}

model DocumentTemplate {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String?        @db.Uuid
  title          String
  type           DocumentType
  bodyTemplate   String
  status         TemplateStatus @default(ACTIVE)
  version        Int            @default(1)
  archivedAt     DateTime?
  archivedById   String?        @db.Uuid
  createdById    String?        @db.Uuid
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, type])
  @@index([organizationId, createdAt])
}
