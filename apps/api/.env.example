# API
PORT=3001
NODE_ENV=development
# Secrets: gere com `openssl rand -base64 32`. Obrigatórios em produção (fail-fast no boot).
JWT_SECRET=troque-por-um-secret-forte
DATABASE_URL=postgresql://flowcare:TROQUE_PELA_SENHA_DO_POSTGRES@localhost:5432/flowcare

# CORS (origens separadas por vírgula)
CORS_ORIGIN=http://localhost:3000

# WAHA
WAHA_BASE_URL=http://localhost:3002
# WAHA_API_KEY=
WAHA_WEBHOOK_SECRET=
WHATSAPP_SEND_ENABLED=false

# Desenvolvimento usa console; produção começa com disabled. Ative ses após verificar o remetente.
MAIL_PROVIDER=console
# Credenciais AWS via IAM role ou cadeia padrão do SDK; nunca coloque chaves no código.
AWS_REGION=us-east-1
MAIL_FROM="Flowcare <noreply@flowcare.me>"
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:ACCOUNT_ID:flowcare-ses-events
SES_CONFIGURATION_SET=flowcare-transactional
APP_WEB_URL=http://localhost:3000
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
