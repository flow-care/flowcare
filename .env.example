# ============================================================
# Flowcare — variáveis de ambiente (produção, deploy Swarm)
# Copie para .env e preencha. NUNCA comite .env (docs/infra/SECRETS.md).
#
# Dev local: o Postgres sobe via `docker compose -f docker-compose.dev.yml up -d`
# e o .env de dev usa as variantes comentadas com localhost.
# ============================================================

# --- Postgres (serviço da stack — INF-02/06) ---
POSTGRES_DB=flowcare
POSTGRES_USER=flowcare
POSTGRES_PASSWORD=TROQUE_POR_UMA_SENHA_FORTE

# Conexão usada pela API. Em produção o host é o SERVIÇO da stack.
# ⚠️ A senha aqui tem que bater com POSTGRES_PASSWORD acima.
DATABASE_URL=postgresql://flowcare:TROQUE_POR_UMA_SENHA_FORTE@flowcare_postgres:5432/flowcare
# Dev nativo: use localhost no DATABASE_URL com a mesma senha do Postgres.
# Dev via Compose: mesma senha de POSTGRES_PASSWORD, host do serviço postgres.
DOCKER_DATABASE_URL=postgresql://flowcare:TROQUE_POR_UMA_SENHA_FORTE@postgres:5432/flowcare

# --- API (Elysia) ---
PORT=3000
NODE_ENV=production
APP_VERSION=0.1.0
JWT_SECRET=GERE_COM_openssl_rand_hex_32
# Origem do front (CORS). Vários ambientes separados por vírgula.
CORS_ORIGIN=https://flowcare.me,https://www.flowcare.me
APP_WEB_URL=https://flowcare.me
# Confie em X-Forwarded-For somente quando a API estiver atrás do Traefik.
TRUST_PROXY=true

# --- Frontend / roteamento de produção (valores sem aspas) ---
# URL interna usada somente pelo servidor Next.js, nunca NEXT_PUBLIC_.
API_INTERNAL_URL=http://flowcare_api:3000/api
API_HOST=api.flowcare.me
WEB_HOST=flowcare.me
WEB_ALT_HOST=www.flowcare.me

# --- WhatsApp / WAHA (deploy já existente — docs/infra/WAHA.md) ---
# Instância da stack "waha" já em produção, acessada pela rede traefik-public
# (alias DNS `waha` dentro do swarm).
WAHA_BASE_URL=http://waha:3000
# Dev via Compose, quando houver uma instância local no host.
DOCKER_WAHA_BASE_URL=http://host.docker.internal:3002
# Chave fica em /root/waha/.credentials (nunca no chat/repo).
WAHA_API_KEY=
# Secret que o back valida no webhook (§8 do contrato) — gerar com openssl rand -hex 32.
WAHA_WEBHOOK_SECRET=
WHATSAPP_SEND_ENABLED=false

# --- E-mail transacional (ative ses após configurar o remetente) ---
MAIL_PROVIDER=disabled
AWS_REGION=us-east-1
MAIL_FROM="Flowcare <noreply@flowcare.me>"
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:ACCOUNT_ID:flowcare-ses-events
SES_CONFIGURATION_SET=flowcare-transactional

# --- Sintesy (transcrição — ADR-002) ---
# mock = dev/testes sem rede; b2b = produção (API B2B); service_account = fallback.
SINTESEY_MODE=mock
SINTESEY_BASE_URL=https://api.sintesy.me
SINTESEY_B2B_API_KEY=
# Custo interno por minuto do modelo stt-low, em centavos (BE-21 usa p/ medir custo).
SINTESEY_COST_PER_MIN_CENTS=0

# --- gorouter (extração de tópicos — BE-20) ---
# Alias "gorouter" resolve na rede shared do swarm.
GOROUTER_BASE_URL=http://gorouter:20128/v1
GOROUTER_API_KEY=
GOROUTER_MODEL=flowcare-extraction

# --- Limites ---
# 500 MB em bytes (RF-D2/§3.4 da espec.: MP3, corta acima disso).
AUDIO_MAX_BYTES=524288000

# --- Deploy ---
# Tag das imagens GHCR usada pelo deploy (deploy.yml injeta o sha do commit).
FLOWCARE_TAG=latest

# --- Alertas (infra/monitoring/check-health.sh, cron opcional) ---
# Webhook que recebe alerta quando /health ou WhatsApp falham (Telegram/Discord).
HEALTH_ALERT_WEBHOOK=

# --- Arquivos privados (S3/R2; nunca commitar credenciais) ---
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
